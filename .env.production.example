APP_NAME=Stpronk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://stpronk.nl

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# The database is expected to run outside of this Docker setup.
# - Same host machine, outside Docker: leave this as host.docker.internal
#   (the php-fpm service maps it to the host via extra_hosts).
# - Reachable via the shared `dbnet` external network (see docker-compose.prod.yml):
#   set this to that database container's name instead.
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=stpronk
DB_USERNAME=
DB_PASSWORD=

BROADCAST_CONNECTION=log
# storage/app/public is a named Docker volume shared between the php-fpm and
# nginx services (see docker-compose.prod.yml), so uploads written by
# php-fpm are immediately visible to nginx and persist across redeploys.
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@stpronk.nl"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_TO_ADDRESS="hello@stpronk.nl"

COMPANY_KVK=83166742

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
